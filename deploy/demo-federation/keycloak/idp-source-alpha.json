{
  "realm": "idp-source-alpha",
  "enabled": true,
  "displayName": "IdP Source Alpha (OIDC)",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "clients": [
    {
      "clientId": "org-alpha-broker",
      "name": "Alpha Broker Client",
      "description": "Used by demo-org-alpha to broker identities via OIDC",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${FEDERATION_ALPHA_BROKER_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:8080/realms/demo-org-alpha/broker/alpha-oidc/endpoint",
        "${FEDERATION_KEYCLOAK_URL}/realms/demo-org-alpha/broker/alpha-oidc/endpoint"
      ],
      "webOrigins": [],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "implicitFlowEnabled": false
    }
  ],
  "users": [
    {
      "username": "alice-alpha",
      "email": "alice@alpha.demo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Alpha",
      "attributes": {
        "org": [
          "alpha"
        ],
        "department": [
          "engineering"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_IDP_SOURCE_ALPHA_ALICE_ALPHA_PASSWORD}",
          "temporary": true
        }
      ]
    },
    {
      "username": "bob-alpha",
      "email": "bob@alpha.demo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Alpha",
      "attributes": {
        "org": [
          "alpha"
        ],
        "department": [
          "operations"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_IDP_SOURCE_ALPHA_BOB_ALPHA_PASSWORD}",
          "temporary": true
        }
      ]
    }
  ],
  "sslRequired": "none",
  "resetPasswordAllowed": false,
  "passwordPolicy": "length(12) and notUsername and passwordHistory(5) and maxLength(128)",
  "clientSessionIdleTimeout": 1800,
  "clientSessionMaxLifespan": 28800,
  "offlineSessionIdleTimeout": 86400,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 604800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "actionTokenGeneratedByUserLifespan": 300,
  "actionTokenGeneratedByAdminLifespan": 3600
}
