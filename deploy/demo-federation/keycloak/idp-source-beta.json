{
  "realm": "idp-source-beta",
  "enabled": true,
  "displayName": "IdP Source Beta (SAML)",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "clients": [
    {
      "clientId": "http://localhost:8080/realms/demo-org-beta",
      "name": "Beta SAML Service Provider",
      "description": "SAML SP descriptor for demo-org-beta broker",
      "enabled": true,
      "protocol": "saml",
      "frontchannelLogout": true,
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.server.signature": "true",
        "saml.client.signature": "false",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_force_name_id_format": "true",
        "saml_name_id_format": "username",
        "saml.authnstatement": "true"
      },
      "redirectUris": [
        "http://localhost:8080/realms/demo-org-beta/broker/beta-saml/endpoint",
        "${FEDERATION_KEYCLOAK_URL}/realms/demo-org-beta/broker/beta-saml/endpoint"
      ]
    }
  ],
  "users": [
    {
      "username": "carol-beta",
      "email": "carol@beta.demo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Beta",
      "attributes": {
        "org": [
          "beta"
        ],
        "department": [
          "finance"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_IDP_SOURCE_BETA_CAROL_BETA_PASSWORD}",
          "temporary": true
        }
      ]
    },
    {
      "username": "dave-beta",
      "email": "dave@beta.demo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dave",
      "lastName": "Beta",
      "attributes": {
        "org": [
          "beta"
        ],
        "department": [
          "compliance"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_IDP_SOURCE_BETA_DAVE_BETA_PASSWORD}",
          "temporary": true
        }
      ]
    }
  ],
  "sslRequired": "none",
  "resetPasswordAllowed": false,
  "passwordPolicy": "length(12) and notUsername and passwordHistory(5) and maxLength(128)",
  "clientSessionIdleTimeout": 1800,
  "clientSessionMaxLifespan": 28800,
  "offlineSessionIdleTimeout": 86400,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 604800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "actionTokenGeneratedByUserLifespan": 300,
  "actionTokenGeneratedByAdminLifespan": 3600
}
