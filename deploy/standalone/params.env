# Parameters for deploy/standalone/apply.sh.
# Defaults match the single-node k3s target. Edit, then run ./apply.sh.

# kubernetes.io/hostname of the node that should run the gateway.
STOA_NODE_HOSTNAME=vmi3109795

# Namespace for the gateway, Keycloak Service, and admin Secret.
STOA_NAMESPACE=stoa

# Public hostname on the ingress-nginx Ingress (Cloudflare origin).
STOA_PUBLIC_HOST=gateway.gostoa.dev

# Local image id from `docker build -t stoa-gateway:0.9.25 stoa-gateway`
# on this branch (2026-10-21). Not published to a registry. See README "Image".
STOA_IMAGE=stoa-gateway@sha256:a8257c8f10341845343c72599aefc87b23a0f52bf38e14136eea4a6641a029fb
