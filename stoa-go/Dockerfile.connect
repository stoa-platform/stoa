FROM golang:1.22-alpine@sha256:1699c10032ca2582ec89a24a1312d986a3f094aed3d5c1147b19880afe40e052 AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -ldflags "-s -w -X main.Version=dev -X main.Commit=$(git rev-parse --short HEAD 2>/dev/null || echo none)" \
    -o /stoa-connect ./cmd/stoa-connect

FROM alpine:3.19@sha256:6baf43584bcb78f2e5847d1de515f23499913ac9f12bdf834811a3145eb11ca1
COPY LICENSE NOTICE /usr/share/licenses/stoa/
RUN apk add --no-cache ca-certificates curl
COPY --from=builder /stoa-connect /usr/local/bin/stoa-connect
ENTRYPOINT ["/usr/local/bin/stoa-connect"]
